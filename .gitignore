# Dependencies
node_modules/

# Frontend build output
dist/
.vite/

# Rust build output
target/
src-tauri/target/

# Tauri generated artifacts (regenerated by tauri-build)
src-tauri/gen/schemas/

# Local environment overrides. This app has no network access, but a stray
# local override must never reach the repository anyway.
.env
.env.local

# Update-signing private keys. Tauri's updater signs releases with a minisign
# keypair; the PRIVATE half must never be committed. A private key pushed once
# is compromised forever -- rewriting history does not un-publish it, because
# GitHub keeps unreachable objects served by SHA. Listed here BEFORE the
# updater work starts, not after.
*.key
.tauri/

# Editors / OS noise
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.log
